<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#343638" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#565B5E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3C3F41" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#1F538D" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#14375E" />
    <SolidColorBrush x:Key="AccentPreviewBrush" Color="#2B719E" />
    <SolidColorBrush x:Key="AccentPreviewHoverBrush" Color="#205578" />
    <SolidColorBrush x:Key="AccentCancelBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="AccentCancelHoverBrush" Color="#8A1F14" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#DCE4EE" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="TextWarningBrush" Color="#E57373" />
    <SolidColorBrush x:Key="TextSuccessBrush" Color="#4CAF50" />
    <SolidColorBrush x:Key="TextOrangeBrush" Color="#FFA500" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#666666" />

    <!-- Corner Radii -->
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">5</CornerRadius>

</ResourceDictionary>
