<Window x:Class="KokoroGUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KokoroGUI.ViewModels"
        mc:Ignorable="d"
        Title="Kokoro TTS GUI"
        Icon="pack://application:,,,/KokoroGUI;component/app.ico"
        Height="900" Width="700"
        MinHeight="750" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Frame -->
        <Grid Grid.Row="0" Margin="5,5,5,10">
            <TextBlock Text="Kokoro TTS"
                       FontFamily="{StaticResource AppFont}" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </Grid>

        <!-- 2. Main Tab View -->
        <TabControl Grid.Row="1" Style="{StaticResource CustomTabControlStyle}">

            <!-- ================= TAB 1: GENERATE AUDIO ================= -->
            <TabItem Header="Generate Audio" Style="{StaticResource CustomTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                    <StackPanel Margin="0,0,5,0">

                        <!-- Input Section -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Input Source" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <TabControl SelectedIndex="{Binding SelectedInputTab}" Style="{StaticResource CustomTabControlStyle}">
                                    <TabItem Header="Direct Text" Style="{StaticResource CustomTabItemStyle}">
                                        <TextBox Text="{Binding DirectText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CustomTextBoxStyle}" Height="110" TextWrapping="Wrap"
                                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" />
                                    </TabItem>
                                    <TabItem Header="Load File" Style="{StaticResource CustomTabItemStyle}">
                                        <StackPanel Margin="0,15,0,0">
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="File Path:" VerticalAlignment="Center" Margin="0,0,10,0"
                                                           FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox Grid.Column="1" Text="{Binding InputFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,5,0" />
                                                <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseInputFileCommand}"
                                                        Style="{StaticResource CustomButtonStyle}" Width="80" />
                                            </Grid>
                                            <TextBlock Text="Supported: .txt, .pdf, .epub"
                                                       FontFamily="{StaticResource AppFont}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="65,2,0,0" />
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <!-- Configuration Section -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Configuration" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                                  Style="{StaticResource CustomComboBoxStyle}" Width="150" Margin="0,0,5,0" />
                                        <Button Content="💾" Command="{Binding SavePresetCommand}"
                                                Style="{StaticResource CustomButtonStyle}" Width="30" Height="28" Margin="0,0,2,0" ToolTip="Save Preset" />
                                        <Button Content="🔄" Command="{Binding RefreshPresetsCommand}"
                                                Style="{StaticResource CustomButtonStyle}" Width="30" Height="28" ToolTip="Refresh Presets" />
                                    </StackPanel>
                                </Grid>

                                <!-- Language -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Language:" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                              Style="{StaticResource CustomComboBoxStyle}" />
                                </Grid>

                                <!-- Voice -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Voice:" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CurrentVoices}" SelectedItem="{Binding SelectedVoice}"
                                              Style="{StaticResource CustomComboBoxStyle}" />
                                </Grid>

                                <!-- Output Folder -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,5,0" />
                                    <Button Grid.Column="2" Content="..." Command="{Binding BrowseOutputDirCommand}"
                                            Style="{StaticResource CustomButtonStyle}" Width="40" />
                                </Grid>

                                <!-- Filename & Format -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Base Filename:" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding BaseFilename, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,5,0" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedFormat}"
                                              Style="{StaticResource CustomComboBoxStyle}" Width="75" />
                                </Grid>

                                <!-- Speed -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SpeedLabel}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" SmallChange="0.1" Value="{Binding Speed}"
                                            Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- Split By -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Split By:" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SplitPatterns}" SelectedItem="{Binding SelectedSplitPatternKey}"
                                              Style="{StaticResource CustomComboBoxStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Audio Control Section -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Audio Control" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <!-- Volume -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding VolumeLabel}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="2.0" SmallChange="0.1" Value="{Binding Volume}"
                                            Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- Pitch -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PitchLabel}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="-12" Maximum="12" SmallChange="1" Value="{Binding Pitch}"
                                            Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- FX Preset -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FX Preset:" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FxPresets}" SelectedItem="{Binding SelectedFxPreset}"
                                              Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,8,0" />
                                    <CheckBox Grid.Column="2" Content="Apply" IsChecked="{Binding ApplyFx}"
                                              Style="{StaticResource CustomCheckBoxStyle}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Toggles -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <CheckBox Content="Normalize" IsChecked="{Binding NormalizeAudio}"
                                              Style="{StaticResource CustomCheckBoxStyle}" Margin="0,0,20,0" />
                                    <CheckBox Content="Trim Silence" IsChecked="{Binding TrimSilence}"
                                              Style="{StaticResource CustomCheckBoxStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Processing Options Section -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Processing Options" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="Keep Segments" IsChecked="{Binding KeepSegments}"
                                              Style="{StaticResource CustomCheckBoxStyle}" Margin="0,0,15,0" />
                                    <CheckBox Content="Combine Output" IsChecked="{Binding CombineOutput}"
                                              Style="{StaticResource CustomCheckBoxStyle}" Margin="0,0,15,0" />
                                    <CheckBox Content="Export Subtitles (.srt)" IsChecked="{Binding ExportSubtitles}"
                                              Style="{StaticResource CustomCheckBoxStyle}" />
                                </StackPanel>

                                <!-- Threads -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                    <TextBlock Text="Parallel Threads:" VerticalAlignment="Center" Margin="0,0,10,0"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Button Content="-" Command="{Binding DecrementThreadsCommand}"
                                            Style="{StaticResource CustomButtonStyle}" Width="30" Height="26" Margin="0,0,2,0" />
                                    <TextBox Text="{Binding NumThreads, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CustomTextBoxStyle}" Width="45" Height="26" TextAlignment="Center" Margin="0,0,2,0" />
                                    <Button Content="+" Command="{Binding IncrementThreadsCommand}"
                                            Style="{StaticResource CustomButtonStyle}" Width="30" Height="26" Margin="0,0,10,0" />
                                    <TextBlock Text="(More threads = High RAM usage)" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{StaticResource TextOrangeBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 2: CUSTOM VOICE (MIXING) ================= -->
            <TabItem Header="Custom Voice" Style="{StaticResource CustomTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                    <StackPanel Margin="0,0,5,0">

                        <!-- 1. Selection -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Voice A -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Voice A:" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding MixLangA}"
                                          Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,8,8" />
                                <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding MixVoicesA}" SelectedItem="{Binding SelectedMixVoiceA}"
                                          Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,0,8" />

                                <!-- Voice B -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Voice B:" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding MixLangB}"
                                          Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,8,0" />
                                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding MixVoicesB}" SelectedItem="{Binding SelectedMixVoiceB}"
                                          Style="{StaticResource CustomComboBoxStyle}" />
                            </Grid>
                        </Border>

                        <!-- 2. Ratio & Operation -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Operation:" VerticalAlignment="Center" Margin="0,0,10,0"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding MixingOperations}" SelectedItem="{Binding SelectedMixingOperation}"
                                              Style="{StaticResource CustomComboBoxStyle}" Width="120" />
                                </StackPanel>

                                <TextBlock Text="{Binding MixRatioLabel}" HorizontalAlignment="Center" Margin="0,5,0,5"
                                           FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />

                                <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.01" Value="{Binding MixRatio}"
                                        Style="{StaticResource CustomSliderStyle}" Margin="10,0,10,5" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Preview Lang & Actions -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Preview Language:" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding PreviewMixLanguage}"
                                              Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,10,0" />
                                    <Button Grid.Column="2" Content="🔊 Preview" Command="{Binding PreviewMixCommand}"
                                            Style="{StaticResource PreviewButtonStyle}" Width="100" HorizontalAlignment="Left" />
                                </Grid>

                                <!-- Save Voice Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="New Voice Name:" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding NewVoiceName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Create &amp; Save" Command="{Binding CreateMixVoiceCommand}"
                                            Style="{StaticResource CustomButtonStyle}" />
                                </Grid>

                                <TextBlock Text="{Binding MixStatus}" Margin="0,8,0,0"
                                           FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 4. Custom Voices List -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Custom Voices:" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CustomVoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#333333" CornerRadius="4" Padding="8,4" Margin="0,2">
                                                    <Grid>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <Button Content="X" Command="{Binding DataContext.DeleteCustomVoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CancelButtonStyle}" Width="28" Height="24" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 3: AUDIO FX ================= -->
            <TabItem Header="Audio FX" Style="{StaticResource CustomTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                    <StackPanel Margin="0,0,5,0">

                        <!-- Preset Header -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding FxPresets}" SelectedItem="{Binding SelectedFxPreset}"
                                          Style="{StaticResource CustomComboBoxStyle}" Width="200" Margin="0,0,8,0" />
                                <Button Content="💾 Save" Command="{Binding SaveFxPresetCommand}"
                                        Style="{StaticResource CustomButtonStyle}" Width="65" Margin="0,0,4,0" />
                                <Button Content="🔄" Command="{Binding RefreshFxPresetsCommand}"
                                        Style="{StaticResource CustomButtonStyle}" Width="30" />
                            </StackPanel>
                        </Grid>

                        <!-- 1. Dynamics -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Dynamics" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <!-- Compressor -->
                                <CheckBox Content="Compressor" IsChecked="{Binding CompEnabled}"
                                          Style="{StaticResource CustomCheckBoxStyle}" FontWeight="Bold" Margin="0,0,0,5" />
                                <Grid Margin="15,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CompThresholdLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding CompThreshold}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CompRatioLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding CompRatio}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- Limiter -->
                                <CheckBox Content="Limiter" IsChecked="{Binding LimiterEnabled}"
                                          Style="{StaticResource CustomCheckBoxStyle}" FontWeight="Bold" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LimiterThresholdLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="-12" Maximum="0" Value="{Binding LimiterThreshold}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- Gain -->
                                <CheckBox Content="Gain" IsChecked="{Binding GainEnabled}"
                                          Style="{StaticResource CustomCheckBoxStyle}" FontWeight="Bold" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GainLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="-20" Maximum="20" Value="{Binding GainDb}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. EQ & Filters -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="EQ &amp; Filters" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding EqBassLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="-20" Maximum="20" Value="{Binding EqBass}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding EqTrebleLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="-20" Maximum="20" Value="{Binding EqTreble}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- HPF -->
                                <CheckBox Content="HighPass Filter" IsChecked="{Binding HighpassEnabled}"
                                          Style="{StaticResource CustomCheckBoxStyle}" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding HighpassLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="20" Maximum="1000" Value="{Binding HighpassFreq}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- LPF -->
                                <CheckBox Content="LowPass Filter" IsChecked="{Binding LowpassEnabled}"
                                          Style="{StaticResource CustomCheckBoxStyle}" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LowpassLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="1000" Maximum="20000" Value="{Binding LowpassFreq}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Spatial & Time -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Spatial &amp; Time" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <!-- Reverb -->
                                <CheckBox Content="Reverb" IsChecked="{Binding ReverbEnabled}"
                                          Style="{StaticResource CustomCheckBoxStyle}" FontWeight="Bold" Margin="0,0,0,5" />
                                <Grid Margin="15,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ReverbRoomLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ReverbRoomSize}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ReverbWetLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ReverbWetLevel}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- Delay -->
                                <CheckBox Content="Delay" IsChecked="{Binding DelayEnabled}"
                                          Style="{StaticResource CustomCheckBoxStyle}" FontWeight="Bold" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DelayTimeLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding DelayTime}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>
                                <Grid Margin="15,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DelayMixLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding DelayMix}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Guitar / Modulation -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Guitar / Modulation" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <!-- Chorus -->
                                <CheckBox Content="Chorus" IsChecked="{Binding ChorusEnabled}" Style="{StaticResource CustomCheckBoxStyle}" Margin="0,0,0,5" />
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ChorusRateLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="10" Value="{Binding ChorusRate}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- Distortion -->
                                <CheckBox Content="Distortion" IsChecked="{Binding DistortionEnabled}" Style="{StaticResource CustomCheckBoxStyle}" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DistortionDriveLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="60" Value="{Binding DistortionDrive}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- Phaser -->
                                <CheckBox Content="Phaser" IsChecked="{Binding PhaserEnabled}" Style="{StaticResource CustomCheckBoxStyle}" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PhaserRateLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="10" Value="{Binding PhaserRate}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <!-- Clipping -->
                                <CheckBox Content="Clipping" IsChecked="{Binding ClippingEnabled}" Style="{StaticResource CustomCheckBoxStyle}" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ClippingThreshLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="-20" Maximum="0" Value="{Binding ClippingThresh}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 5. Quality / Pitch -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Quality / Pitch" FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <CheckBox Content="Pitch Shift (High Quality)" IsChecked="{Binding PitchShiftEnabled}" Style="{StaticResource CustomCheckBoxStyle}" Margin="0,0,0,5" />
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PitchShiftLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding PitchShiftSemitones}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <CheckBox Content="Bitcrush" IsChecked="{Binding BitcrushEnabled}" Style="{StaticResource CustomCheckBoxStyle}" Margin="0,4,0,5" />
                                <Grid Margin="15,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BitcrushDepthLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="2" Maximum="16" Value="{Binding BitcrushDepth}" Style="{StaticResource CustomSliderStyle}" />
                                </Grid>

                                <CheckBox Content="GSM Compressor (Phone Quality)" IsChecked="{Binding GsmEnabled}" Style="{StaticResource CustomCheckBoxStyle}" Margin="0,4,0,5" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 4: LEXICON ================= -->
            <TabItem Header="Lexicon" Style="{StaticResource CustomTabItemStyle}">
                <Grid Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Add Rule Row -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Original Text:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding NewLexiconOrig, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,12,0" />

                            <TextBlock Grid.Column="2" Text="Replacement:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="3" Text="{Binding NewLexiconReplace, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,12,0" />

                            <Button Grid.Column="4" Content="Add Rule" Command="{Binding AddLexiconRuleCommand}"
                                    Style="{StaticResource CustomButtonStyle}" Width="85" />
                        </Grid>
                    </Border>

                    <!-- Rules List -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LexiconRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#333333" CornerRadius="4" Padding="10,6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Original}"
                                                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="->"
                                                           FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Replacement}"
                                                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="X"
                                                        Command="{Binding DataContext.DeleteLexiconRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CancelButtonStyle}" Width="28" Height="24" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Note -->
                    <TextBlock Grid.Row="2" Text="Note: Replacements are case-insensitive. Applied before generation."
                               FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </Grid>
            </TabItem>

        </TabControl>

        <!-- 3. Bottom Global Actions Section -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0">
            <StackPanel>
                <!-- Status & Detail Labels -->
                <TextBlock Text="{Binding StatusText}"
                           FontFamily="{StaticResource AppFont}" FontSize="13"
                           Foreground="{Binding IsStatusError, Converter={x:Null}, TargetNullValue={StaticResource TextMutedBrush}}" Margin="0,0,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextWarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding DetailText}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressValue}" Maximum="1.0"
                             Style="{StaticResource CustomProgressBarStyle}" Height="12" Margin="0,0,0,4" />

                <!-- Info Label -->
                <TextBlock Text="{Binding InfoText}" HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Preview Audio" Command="{Binding PreviewAudioCommand}"
                            Style="{StaticResource PreviewButtonStyle}" Height="40" Margin="0,0,5,0" />

                    <Button Grid.Column="1" Content="{Binding StartButtonText}" Command="{Binding StartConversionCommand}"
                            Style="{StaticResource CustomButtonStyle}" Height="40" FontWeight="Bold" FontSize="14" Margin="5,0,5,0" />

                    <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}"
                            Style="{StaticResource CancelButtonStyle}" Height="40" Margin="5,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
