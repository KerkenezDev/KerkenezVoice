<Window x:Class="KokoroGUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Icon="pack://application:,,,/KokoroGUI;component/app.ico"
        Height="380" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Border Style="{StaticResource CardBorderStyle}" Margin="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Appearance -->
            <TextBlock Grid.Row="0" Text="Appearance Mode:"
                       FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,5" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding AppearanceModes}" SelectedItem="{Binding SelectedAppearance}"
                      Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,0,15" />

            <!-- Scaling -->
            <TextBlock Grid.Row="2" Text="UI Scaling:"
                       FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
            <ComboBox Grid.Row="3" ItemsSource="{Binding ScalingOptions}" SelectedItem="{Binding SelectedScaling}"
                      Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,0,15" />

            <!-- Caching -->
            <TextBlock Grid.Row="4" Text="Generation Cache:"
                       FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
            <CheckBox Grid.Row="5" Content="Enable Generation Caching" IsChecked="{Binding CachingEnabled}"
                      Style="{StaticResource CustomCheckBoxStyle}" Margin="0,0,0,15" />

            <!-- JIT -->
            <TextBlock Grid.Row="6" Text="Real-time / JIT:"
                       FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5" />
            <CheckBox Grid.Row="7" Content="Enable JIT Generation (Streaming)" IsChecked="{Binding JitEnabled}"
                      Style="{StaticResource CustomCheckBoxStyle}" Margin="0,0,0,10" />

            <!-- Note -->
            <TextBlock Grid.Row="8" Text="Note: Restart may be required for optimal scaling."
                       FontFamily="{StaticResource AppFont}" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,5,0,0" />

            <!-- Close Button -->
            <Button Grid.Row="9" Content="Close" Click="CloseButton_Click"
                    Style="{StaticResource CustomButtonStyle}" Height="32" Margin="0,10,0,0" />
        </Grid>
    </Border>
</Window>
